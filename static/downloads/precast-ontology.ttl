pc:Country_Uzbekistan a pc:Country ; skos:prefLabel "Uzbekistan"@en, "أوزبكستان"@ar ; pc:partOfRegion pc:Region_CentralAsia .
pc:Country_Azerbaijan a pc:Country ; skos:prefLabel "Azerbaijan"@en, "أذربيجان"@ar ; pc:partOfRegion pc:Region_Caucasus .
pc:Country_Georgia a pc:Country ; skos:prefLabel "Georgia"@en, "جورجيا"@ar ; pc:partOfRegion pc:Region_Caucasus .
pc:Country_Albania a pc:Country ; skos:prefLabel "Albania"@en, "ألبانيا"@ar ; pc:partOfRegion pc:Region_Balkans .
pc:Country_Montenegro a pc:Country ; skos:prefLabel "Montenegro"@en, "الجبل الأسود"@ar ; pc:partOfRegion pc:Region_Balkans .
pc:Country_Serbia a pc:Country ; skos:prefLabel "Serbia"@en, "صربيا"@ar ; pc:partOfRegion pc:Region_Balkans .
pc:Country_DominicanRepublic a pc:Country ; skos:prefLabel "Dominican Republic"@en, "الدومينيكان"@ar ; pc:partOfRegion pc:Region_Caribbean .
pc:Country_Indonesia a pc:Country ; skos:prefLabel "Indonesia"@en, "إندونيسيا"@ar ; pc:partOfRegion pc:Region_SouthEastAsia .
pc:Country_Kenya a pc:Country ; skos:prefLabel "Kenya"@en, "كينيا"@ar ; pc:partOfRegion pc:Region_EastAfrica .
pc:Region_Balkans a pc:Region ; rdfs:label "Balkans"@en .
pc:Region_Caribbean a pc:Region ; rdfs:label "Caribbean"@en .
pc:Region_Caucasus a pc:Region ; rdfs:label "Caucasus"@en .
pc:Region_CentralAsia a pc:Region ; rdfs:label "Central Asia"@en .
pc:Region_EastAfrica a pc:Region ; rdfs:label "East Africa"@en .
pc:Region_GCC a pc:Region ; rdfs:label "GCC"@en .
pc:Region_Levant a pc:Region ; rdfs:label "Levant"@en .
pc:Region_NorthAfrica a pc:Region ; rdfs:label "North Africa"@en .
pc:Region_SouthEastAsia a pc:Region ; rdfs:label "South-East Asia"@en .
